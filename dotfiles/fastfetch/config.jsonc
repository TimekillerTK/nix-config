{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // Custom image logo via the Kitty graphics protocol, changing the overall
  // layout from the default ASCII art. Drop an image at
  // ~/.config/fastfetch/logo.png
  // for this to render; width/height are required by kitty-direct.
  "logo": {
    "type": "kitty",
    "source": "/home/tk/.config/fastfetch/logo.png",
    "width": 30,
    "height": 15
  },
  "display": {
    "separator": " -> "
  },
  "modules": [
    "title",
    "separator",
    "bios",
    "board",
    "zpool",
    "terminalfont",
    "uptime",
    "wm",
    "de",
    "dns",
    "editor",
    "font",
    "monitor",
    "bootmgr",
    "tpm",
    "separator",
    "os",
    "kernel",
    "host",
    "uptime",
    "packages",
    "shell",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "swap",
    {
      "type": "physicaldisk",
      "key": "Disk"
    },
    {
      "type": "disk",
      "key": "/boot",
      "folders": [
        "/boot"
      ],
      "hideFolders": [
        ""
      ]
    },
    {
      "type": "command",
      "key": "ZFS Pool",
      "text": "zpool list -Ho name,size,alloc,free,cap zroot | awk '{printf \"%s: %s used / %s total, %s free (%s)\", $1, $3, $2, $4, $5}'"
    },
    "break",
    "colors"
  ]
}